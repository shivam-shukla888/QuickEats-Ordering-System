# ==========================================
# QuickEats Backend Production Environment Variables
# Copy these to Render Dashboard -> Environment Tab
# ==========================================

# Database Connection (Render PostgreSQL)
# Format: jdbc:postgresql://<Internal Database URL Host>:5432/<Database Name>
SPRING_DATASOURCE_URL=jdbc:postgresql://dpg-xxxxxxxxx-a:5432/quickeatsdb
SPRING_DATASOURCE_USERNAME=quickeats_user
SPRING_DATASOURCE_PASSWORD=your_render_postgres_password

# Database Schema Management (Use 'update' for initial table creation, 'validate' for strict production safety)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Security Secret (Must be 256-bit+ secure random key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Allowed CORS Origins (Comma separated URLs)
CORS_ALLOWED_ORIGINS=https://quickeats-sandy.vercel.app,http://localhost:5173

# Groq AI LLM API Key (For AI Agents & Search Recommendations)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Firebase Push Notifications (Optional)
FIREBASE_PROJECT_ID=quickeats-2e295
FIREBASE_SERVICE_ACCOUNT_PATH=classpath:firebase-service-account.json
