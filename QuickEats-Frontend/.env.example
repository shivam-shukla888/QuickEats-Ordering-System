# QuickEats Frontend Environment Variables Configuration Template
# For local development: copy this file to .env.local
# For Vercel deployment: Add these variables under Project Settings > Environment Variables

# Backend Base API URL (e.g. Render hosted backend URL or http://localhost:8080 for local backend)
VITE_API_BASE_URL=https://quickeats-ordering-system.onrender.com

# Razorpay Test Key ID (Exposing Key ID in frontend code is standard & safe)
# DO NOT include Razorpay Key Secret here! Key Secret must remain ONLY in backend environment settings.
# Obtain your Test Key ID from Razorpay Dashboard (https://dashboard.razorpay.com/app/keys)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholderKeyId
